{
  "name": "gyeol-grain-of-sound",
  "version": "1.0.0",
  "private": true,
  "description": "비영리 전통연희단체 연희단 결 (GYEOL : The Grain of Sound) 공식 소개 및 섭외·모집 웹페이지",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-30030}",
    "dev:30030": "next dev -H 0.0.0.0 -p 30030",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-30030}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "seed:reset": "tsx --env-file=.env src/scripts/seed.ts --reset"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "next": "^15.3.1",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "playwright": "^1.50.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
