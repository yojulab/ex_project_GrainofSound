# ==============================================================================
# 비영리 전통연희단체 「연희단 결 (GYEOL : The Grain of Sound)」 환경 변수 템플릿 (.env.example)
#
# [안내]
# 본 시스템은 코드 내 하드코딩된 디폴트 정보를 허용하지 않습니다.
# 배포 및 실행 전 본 파일을 복사하여 .env 파일을 생성하고 모든 필수 변수를 정의해야 합니다.
#   $ cp .env.example .env
# ==============================================================================

# 1. 데이터베이스 연결 URI (필수, DB명: grain_of_sound)
# 예시: Docker 컨테이너: mongodb://admin:PASSWORD@graphrag_agent_db_mongo:27017/grain_of_sound?authSource=admin
# 예시: GCP GCE VM 사설망: mongodb://gyeol_app:PASSWORD@10.x.x.x:27017/grain_of_sound?authSource=grain_of_sound
# 예시: 로컬 개발망: mongodb://127.0.0.1:27017/grain_of_sound
MONGODB_URI=

# 2. 세션 암호화 키 (필수, 최소 32자 이상 강력한 무작위 문자열)
SESSION_SECRET=

# 3. 초기 관리자 계정 정보 (필수)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@gyeol.or.kr
INITIAL_ADMIN_PASSWORD=

# 4. 서비스 네트워크 포트 및 공식 도메인 URL
PORT=3130
NEXT_PUBLIC_APP_URL=https://neptune.axfoundly.com
BASE_URL=https://neptune.axfoundly.com

# 5. 카카오톡 오픈채팅 1:1 직통 URL
NEXT_PUBLIC_KAKAO_OPENCHAT_URL=https://open.kakao.com/o/gyeol_official

# 6. GCP 인프라 및 스토리지 연동 (운영 배포 시 필수)
GCP_PROJECT_ID=grain-of-sound-portal
GCS_BACKUP_BUCKET=grain-of-sound-db-backups
GCS_MEDIA_BUCKET=grain-of-sound-media-storage
STORAGE_DRIVER=local

# 7. 3대 액션 폼(섭외·단원·후원 문의) 알림 SMTP 메일 발송 설정 (필수)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_MAIL_TO=contact@gyeol.or.kr
CONTACT_MAIL_FROM="연희단 결 (GYEOL) <no-reply@gyeol.or.kr>"
