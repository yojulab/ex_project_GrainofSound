{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug Server (Port 3130)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:3130"
    },
    {
      "name": "Next.js: Full Stack (Server + Chrome, Port 3130)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:3130",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Next.js: Attach to Node (Port 3131)",
      "type": "node",
      "request": "attach",
      "port": 3131,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Next.js: Debug Client (Chrome, Port 3130)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3130",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
